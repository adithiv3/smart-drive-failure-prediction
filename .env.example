# Copy to `.env` and edit. `.env` is git-ignored; this template is committed.
#
#     cp .env.example .env
#
# No secrets belong in this file.

# --- Data locations --------------------------------------------------------
# Backblaze daily CSVs, or a .zip archive. Directories are searched
# recursively.
SDFP_RAW_DATA_DIR=data/raw

# Where the pipeline writes the labelled table and the feature table.
SDFP_PROCESSED_DATA_DIR=data/processed

# Trained models, SHAP plots and metric reports.
SDFP_ARTIFACTS_DIR=artifacts

# --- Modelling problem definition ------------------------------------------
# Predict failure within this many calendar days after the observation.
SDFP_HORIZON_DAYS=7

# Length of the trailing feature window, in calendar days.
SDFP_WINDOW_DAYS=30

# Drop observations from drives with less prior history than this.
SDFP_MIN_HISTORY_DAYS=7

# --- Chronological split ---------------------------------------------------
# First date of the test period (YYYY-MM-DD). Blank splits by fraction.
SDFP_TEST_START_DATE=

# Used when SDFP_TEST_START_DATE is blank.
SDFP_TEST_FRACTION=0.2

# --- Inference service -----------------------------------------------------
SDFP_API_HOST=127.0.0.1
SDFP_API_PORT=8000

# Model file the API loads at startup, relative to SDFP_ARTIFACTS_DIR.
SDFP_MODEL_FILE=model.joblib

# Probability at or above which a drive-day is flagged. Pick this from the
# precision-recall curve for a chosen alert budget.
SDFP_ALERT_THRESHOLD=0.5

# --- Logging ---------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR.
SDFP_LOG_LEVEL=INFO
